node_modules/
dist/

# Maalebyg fra spor: dist-c, dist-e, dist-p ... Et spor, der skal maale sit
# eget resultat mod main, bygger til en sidemappe frem for at overskrive dist/.
# De blev efterladt som usporede 44-51 MB mapper tre gange 26. aug 2026, foer
# moensteret blev daekket her.
dist-*/
.DS_Store
Thumbs.db
*.log

# Inspirationsmateriale: skaermbilleder af ANDRES sider. Samme grund som nedenfor -
# det er deres ophavsret, og det skal ikke distribueres med repoet.
media/inspiration/**
!media/inspiration/*.md

# Fabrikantmateriale: beholdes lokalt som bevis, distribueres aldrig
media/_kilder/**
!media/_kilder/*.md

# Agenternes arbejdsfiler og testkoerslens midlertidige output.
# Moensteret daekker ogsaa tests/.tmp-billedkaede/ og de byg, testen laver
# undervejs - en ny linje pr. midlertidig mappe blev glemt to gange.
.tmp/
tests/.tmp-*/

# Billedagentens arbejdsmappe: fabrikantmateriale, aldrig distribution
media/_arbejde/**

# Fabrikantbilleder, R18 kraever i assets/ (byg og validator laeser kun her),
# men de er stadig fabrikantens ophavsret og maa ikke i git-historikken - kun
# lokalt (L13). Samme regel som media/_kilder/, blot paa den sti R18 kraever.
assets/fotos/fabrikant/**

# Inspirationsmateriale: andres ophavsret
media/inspiration/**

# L34 (db/): Supabase-noegler. Maa ALDRIG committes - se db/LAESMIG.md
.env
db/kanonisk.json
db/seed.sql

# retning-lys-mockuppens scratch: uddragsscript, QA-skaermbilleder, mellemliggende
# JSON fra byggeprocessen. Ikke en del af de fire leverede sider.
prototype/retning-lys/_ref/

# Retning "instrument" (spor/instrument) kopierer fabrikantfotos fra
# assets/fotos/fabrikant/ ind i retninger/instrument/billeder/, saa
# proevesiden kan aabnes selvstaendigt. Samme regel som linje 25-28 ovenfor:
# billederne er stadig fabrikantens ophavsret og maa ikke i git-historikken,
# kun lokalt i worktreen. Gaelder enhver fremtidig retnings-mappe med samme
# moenster, ikke kun denne ene.
retninger/*/billeder/**
