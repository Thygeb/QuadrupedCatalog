node_modules/
dist/
.DS_Store
Thumbs.db
*.log

# Inspirationsmateriale: skaermbilleder af ANDRES sider. Samme grund som nedenfor -
# det er deres ophavsret, og det skal ikke distribueres med repoet.
media/inspiration/**
!media/inspiration/*.md

# Fabrikantmateriale: beholdes lokalt som bevis, distribueres aldrig
media/_kilder/**
!media/_kilder/*.md

# Agenternes arbejdsfiler og testkoerslens midlertidige output.
# Moensteret daekker ogsaa tests/.tmp-billedkaede/ og de byg, testen laver
# undervejs - en ny linje pr. midlertidig mappe blev glemt to gange.
.tmp/
tests/.tmp-*/

# Billedagentens arbejdsmappe: fabrikantmateriale, aldrig distribution
media/_arbejde/**

# Fabrikantbilleder, R18 kraever i assets/ (byg og validator laeser kun her),
# men de er stadig fabrikantens ophavsret og maa ikke i git-historikken - kun
# lokalt (L13). Samme regel som media/_kilder/, blot paa den sti R18 kraever.
assets/fotos/fabrikant/**

# Inspirationsmateriale: andres ophavsret
media/inspiration/**

# L34 (db/): Supabase-noegler. Maa ALDRIG committes - se db/LAESMIG.md
.env
